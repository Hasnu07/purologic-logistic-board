<%- include('partials/head') %>
<body>
<div class="wrap"><div class="frame">
<%- include('partials/auth_side') %>
<section class="auth-main">
  <form class="auth-card" method="post" action="/login">
    <div><h1>Sign in</h1><p class="sub" style="font-size:17px">Use the account we gave you. Admins, staff and clients all sign in here.</p></div>
    <% if (flash) { %><div class="flash"><%= flash.text %></div><% } %>
    <% if (error) { %><div class="flash flash-err" role="alert"><%= error %></div><% } %>
    <div><label class="lb" for="email">Email</label><input id="email" name="email" class="in" type="email" value="<%= email %>" placeholder="you@company.com" autocomplete="username" required autofocus></div>
    <div><label class="lb" for="pw">Password</label><input id="pw" name="password" class="in" type="password" placeholder="Your password" autocomplete="current-password" required></div>
    <label class="check"><input type="checkbox" name="remember">Stay signed in on this device</label>
    <button class="btn btn-primary btn-wide">Open the board<%- icon('arrow', 18, 2.2) %></button>
    <p class="hint" style="text-align:center">Forgot your password? Contact us and we will issue a new one. Your client number is on every shipment document we send you.</p>
  </form>
</section>
</div></div>
</body>
</html>
