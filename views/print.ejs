<%- include('partials/head') %>
<body class="sheet-body" data-auto="<%= auto ? '1' : '0' %>">
<div class="toolbar">
  <button class="btn btn-primary" type="button" data-print><%- icon('print') %>Print (A4)</button>
  <a class="btn" href="/admin/shipments/<%= sh.id %>">Back to watch</a>
</div>
<div class="sheet">
  <div class="sheet-top">
    <div class="b"><%- icon('truck', 16) %><%= settings.company_name %> · Logistic Board · Auto print</div>
    <div>Shipment <strong style="color:#111"><%= sh.shipment_no %></strong> · printed <%= fmtDate(new Date().toISOString()) %> · <%= fmtTime(new Date().toISOString()) %> · by <%= user.name %></div>
  </div>

  <section class="label-box" aria-label="Address label">
    <div class="label-to">
      <p class="pk">Deliver to<%= sh.addr_note ? ' · ' + sh.addr_note : '' %></p>
      <div class="label-name"><%= sh.addr_name || sh.client_name %></div>
      <div class="label-addr"><%= sh.addr_lines || '[No delivery address on file]' %></div>
      <div style="font-size:14px;color:#444"><%= sh.addr_phone ? 'Tel. ' + sh.addr_phone + ' · ' : '' %>Client no. <strong style="color:#111"><%= sh.client_no %></strong></div>
    </div>
    <div class="label-from">
      <p class="pk">From</p>
      <div style="line-height:1.45;white-space:pre-line"><strong><%= settings.company_name %></strong>
<%= settings.sender_address || '[Add your sender address in Users → Settings]' %></div>
      <%- code39(sh.shipment_no) %>
      <div class="barcode-text"><%= sh.shipment_no %> · <%= watches.map((w) => w.watch_no).join(' · ') %></div>
      <% if (watches.length > 1) { %><div style="font-size:13px;color:#444;margin-top:4px"><strong style="color:#111"><%= watches.length %> watches</strong> in this shipment · one sheet each below</div><% } %>
    </div>
  </section>

  <div class="cut" aria-hidden="true"><i></i><span><%- icon('scissors', 14) %>cut here · label above, sheet<%= watches.length > 1 ? 's' : '' %> below</span><i></i></div>

  <% watches.forEach((w, wi) => { const accessories = w.accessories; %>
  <section aria-label="Watch sheet" class="<%= wi ? 'sheet-next' : '' %>" style="display:flex;flex-direction:column;gap:12px">
    <div class="row between" style="align-items:baseline;flex-wrap:nowrap">
      <h1 style="font-size:22px;font-weight:700">Watch sheet · <%= w.watch %><%= watches.length > 1 ? ' (' + (wi + 1) + ' of ' + watches.length + ')' : '' %></h1>
      <div style="font-size:18px;font-weight:700;letter-spacing:.06em;white-space:nowrap"><%= w.watch_no %></div>
    </div>
    <div style="display:flex;gap:16px;align-items:flex-start">
      <table style="flex:1">
        <tbody>
          <tr><th>Reference</th><td><%= w.reference || '—' %></td></tr>
          <tr><th>Serial</th><td><%= w.serial || '—' %></td></tr>
          <tr><th>Watch date</th><td><%= w.watch_date || '—' %></td></tr>
          <tr><th>Declared value</th><td class="b"><%= w.value === null ? '—' : cur + ' ' + w.value.toLocaleString('en-US', { minimumFractionDigits: 2 }) %></td></tr>
          <tr><th>Accessories</th><td>
            <%= accessories.filter((a) => a.ok).map((a) => a.label).join(' · ') || 'None recorded' %>
            <% const missing = accessories.filter((a) => !a.ok).map((a) => a.label); if (missing.length) { %><br><span style="color:#444">Not included: <%= missing.join(', ').toLowerCase() %></span><% } %>
          </td></tr>
          <tr><th>Shipment cost</th><td class="b"><%= sh.cost === null ? 'To be confirmed' : cur + ' ' + sh.cost.toLocaleString('en-US', { minimumFractionDigits: 2 }) %><%= watches.length > 1 ? ' · for all ' + watches.length + ' watches' : '' %></td></tr>
          <tr><th>Courier · AWB</th><td><%= [sh.courier, sh.awb, w.insurance].filter(Boolean).join(' · ') || '—' %></td></tr>
          <tr><th>Collected</th><td><%= fmtDate(sh.collected_at) %> · <%= fmtTime(sh.collected_at) %><%= first && first.location ? ' · ' + first.location : '' %></td></tr>
          <tr><th>Route</th><td><%= route(sh) %></td></tr>
          <tr><th>Client</th><td><%= sh.client_no %> · <%= sh.client_name %><%= sh.client_city ? ' · ' + sh.client_city : '' %></td></tr>
        </tbody>
      </table>
      <% const mine = photos.filter((p) => !p.watch_id || p.watch_id === w.id); %>
      <div class="sheet-photos">
        <p class="pk">Pictures on file · <%= mine.length %></p>
        <% mine.slice(0, 3).forEach((p) => { %><figure><img src="/files/photo/<%= p.id %>" alt="<%= p.label %>"></figure><% }) %>
        <% if (!mine.length) { %><figure>No pictures yet</figure><% } %>
      </div>
    </div>
    <div class="sign">
      <div><div></div><p class="pk">Received by (print name)</p></div>
      <div><div></div><p class="pk">Date &amp; time</p></div>
      <div><div></div><p class="pk">Signature</p></div>
    </div>
  </section>
  <% }) %>

  <div class="sheet-foot">
    <span>Keep this sheet with the watch until delivery is confirmed in the portal. Numbers are unique and never reused.</span>
    <span class="nowrap"><%= watches.length %> watch sheet<%= watches.length === 1 ? '' : 's' %></span>
  </div>
</div>
<script src="/static/print.js"></script>
</body>
</html>
