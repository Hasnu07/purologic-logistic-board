<%- include('../partials/top') %>
<div><h1>Documents</h1><p class="sub">Air waybills, insurance certificates, customs papers and delivery receipts, grouped by shipment.</p></div>
<% if (!groups.length) { %>
<div class="tile empty">No documents yet. They appear here as soon as we add them to one of your shipments.</div>
<% } %>
<% groups.forEach((g) => { %>
<section class="tile stack" style="padding:28px;gap:4px">
  <div class="row between" style="margin-bottom:8px"><h2><%= g.watch %></h2><a class="no" href="/client/shipments/<%= g.sid %>"><%= g.shipment_no %></a></div>
  <% g.docs.forEach((d) => { %>
  <div class="file-row">
    <span class="ico ico-soft"><%- icon('doc') %></span>
    <div class="grow"><div class="b"><%= d.name %></div><div class="small muted"><%= d.mime === 'application/pdf' ? 'PDF' : 'Image' %>, <%= fileSize(d.size) %>, <%= fmtDate(d.created_at) %></div></div>
    <a class="btn btn-sm" href="/files/doc/<%= d.id %>" target="_blank" rel="noopener"><%- icon('download', 16) %>Download</a>
  </div>
  <% }) %>
</section>
<% }) %>
<%- include('../partials/mid') %>
<div><h1 style="font-size:28px">About your documents</h1></div>
<div class="panel">
  <p class="hint">Every document carries your client number <strong style="color:var(--ink)"><%= user.number %></strong> and the watch number, so it can always be matched to the right piece.</p>
  <p class="hint">Missing a paper? Contact us and we will add it to the shipment.</p>
</div>
<%- include('../partials/bottom') %>
