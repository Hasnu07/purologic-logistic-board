<%- include('../partials/top') %>
<div class="head">
  <div><h1>My shipments</h1><p class="sub">Every watch we have collected from you, with its collected date and time, status and cost.</p></div>
  <a class="btn btn-primary" href="/client/shipments/new"><%- icon('plus', 18, 2.2) %>New shipment</a>
</div>

<div class="tabs">
  <% [['active', 'Active'], ['delivered', 'Delivered'], ['all', 'History']].forEach(([key, label]) => { %>
  <a class="<%= tab === key ? 'on' : '' %>" href="/client/shipments?tab=<%= key %><%= q ? '&q=' + encodeURIComponent(q) : '' %>"><%= label %><span class="n"><%= tabs[key].length %></span></a>
  <% }) %>
</div>

<div class="tile table-tile">
  <% if (!rows.length) { %><div class="empty"><%= q ? 'Nothing matches that search.' : tab === 'active' ? 'No shipments are moving right now.' : 'Nothing here yet.' %></div><% } else { %>
  <div class="scroll"><table>
    <thead><tr><th>Watch no.</th><th>Watch</th><th>Shipment</th><th>Received</th><th>Status</th><th>Cost</th><th>Delivered</th><th><span class="sr">Open</span></th></tr></thead>
    <tbody>
    <% rows.forEach((r) => { %>
    <tr>
      <td class="no"><%= r.watch_no_label %></td>
      <td class="b"><%= r.watch_label %></td>
      <td><%= r.shipment_no %></td>
      <td><%= fmtDT(r.collected_at) %></td>
      <td><span class="<%= chipClass(r.status) %>"><%= r.status %></span></td>
      <td class="b"><%= r.cost === null ? 'To confirm' : money(r.cost, cur) %></td>
      <td class="muted"><%= r.delivered_at ? fmtDT(r.delivered_at) + (r.signed_by ? ', ' + r.signed_by : '') : '—' %></td>
      <td><a class="rb rb-line rb-sm" href="/client/shipments/<%= r.id %>" aria-label="Track <%= r.shipment_no %>"><%- icon('arrow', 16, 2.2) %></a></td>
    </tr>
    <% }) %>
    </tbody>
  </table></div>
  <% } %>
</div>

<%- include('../partials/mid') %>
<div id="request" class="row between" style="align-items:baseline"><h1 style="font-size:28px">Your requests</h1><span class="small muted b"><%= requests.length %></span></div>
<p class="sub" style="margin-top:-8px">A request is what you send us. Once we have the watches it becomes a shipment with its own numbers.</p>
<a class="btn btn-primary btn-wide" href="/client/shipments/new"><%- icon('plus', 18, 2.2) %>New shipment</a>
<% if (!requests.length) { %>
<p class="small muted">You have not sent a request yet.</p>
<% } %>
<% requests.forEach((q) => { %>
<div class="note <%= q.status === 'open' ? 'note-amber' : 'note-plain' %>" id="r<%= q.id %>" style="display:block">
  <div class="row between" style="flex-wrap:nowrap;align-items:flex-start">
    <div class="grow">
      <div class="t" style="color:var(--ink)"><%= q.watch_label %></div>
      <div class="s"><%= q.kind === 'dropoff' ? 'You send them to us' : 'We collect, ' + fmtDT(q.preferred_at) %><%= q.declared !== null ? ' \u00b7 ' + money(q.declared, cur) + ' declared' : '' %></div>
    </div>
    <span class="chip <%= q.status === 'open' ? 'chip-amber' : q.status === 'done' ? 'chip-teal' : '' %>"><%= q.status === 'open' ? 'Waiting for us' : q.status === 'done' ? 'Collected' : 'Cancelled' %></span>
  </div>
  <% if (q.watch_items.length) { %>
  <ul class="small" style="padding-left:18px;margin-top:8px;color:var(--muted)">
    <% q.watch_items.forEach((w) => { %><li><%= w.watch %><%= w.reference ? ' \u00b7 ' + w.reference : '' %><%= w.value !== null && w.value !== undefined ? ' \u00b7 ' + money(Number(w.value), cur) : '' %></li><% }) %>
  </ul>
  <% } %>
  <div class="s" style="margin-top:8px">To <%= [q.d_name, q.d_city, q.d_country].filter(Boolean).join(', ') || 'address on your account' %></div>
  <% if (q.status === 'open') { %>
  <form method="post" action="/client/requests/<%= q.id %>/cancel" style="margin-top:10px"><button class="btn btn-sm">Cancel this request</button></form>
  <% } %>
</div>
<% }) %>
<script src="/static/form.js" defer></script>
<%- include('../partials/bottom') %>
