<% const base = user.role === 'client' ? '/client' : '/admin'; const staff = user.role !== 'client'; %>
<article class="tile stack" style="padding:24px 26px">
  <div class="row between" style="align-items:flex-start;flex-wrap:nowrap">
    <div style="min-width:0"><h3 style="font-size:20px"><%= s.watch_label %></h3><div class="small muted" style="margin-top:4px;font-size:14px"><%= s.status === 'Delivered' ? 'Delivered ' + fmtDT(s.delivered_at) : 'Collected ' + fmtDT(s.collected_at) %></div></div>
    <span class="no small"><%= s.watch_no_label %></span>
  </div>
  <div class="row" style="gap:8px">
    <span class="<%= chipClass(s.status) %>"><%= s.status %></span>
    <span class="chip"><%= staff ? route(s) : (s.last_location || route(s)) %></span>
    <% if (user.role !== 'courier') { %><span class="chip chip-coral-soft"><%= s.cost === null ? (staff ? 'No cost yet' : 'Cost to confirm') : money(s.cost, cur) %></span><% } %>
  </div>
  <div class="row between" style="flex-wrap:nowrap">
    <% if (staff) { %>
    <span class="row" style="gap:0;min-width:0;flex-wrap:nowrap"><span class="av"><%= initials(s.client_name) %></span><% if (s.courier) { %><span class="av av-coral" title="<%= s.courier %>"><%= initials(s.courier) %></span><% } %><span class="small muted" style="margin-left:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= s.client_name %>, <%= s.client_no %></span></span>
    <% } else { %><span class="small muted"><%= s.eta_note || s.shipment_no %></span><% } %>
    <span class="row" style="flex-wrap:nowrap">
      <% if (staff && user.role !== 'courier') { %><a class="rb rb-line" href="/admin/shipments/<%= s.id %>/edit" aria-label="Edit <%= s.shipment_no %>"><%- icon('pencil', 16, 2.2) %></a><% } %>
      <a class="rb" href="<%= base %>/shipments/<%= s.id %>" aria-label="Open <%= s.shipment_no %>"><%- icon('arrow', 16, 2.4) %></a>
    </span>
  </div>
</article>
