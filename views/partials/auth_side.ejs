<section class="auth-side">
  <div class="row" style="gap:14px"><span class="mark" style="width:52px;height:52px"></span><span class="b" style="font-size:20px"><%= settings.company_name %> Logistic Board</span></div>
  <div>
    <h1>Every watch, every step, on one board.</h1>
    <p class="lead">Collect, track and deliver with a unique number for every client and every watch. Admins run the board, clients follow their own shipments.</p>
  </div>
  <div class="feats">
    <div class="feat"><span class="ico" style="background:var(--amber);color:var(--ink)"><%- icon('pin') %></span><h3>Live tracking</h3><p>Received, inspected, packed, on the way, delivered, with time stamps.</p></div>
    <div class="feat"><span class="ico" style="background:var(--coral);color:var(--ink)"><%- icon('clock') %></span><h3>Time tracker</h3><p>How long each shipment sits at every stage.</p></div>
    <div class="feat"><span class="ico" style="background:var(--teal-soft2);color:var(--teal)"><%- icon('users') %></span><h3>Multi login</h3><p>Admin, staff, courier and client roles, several devices at once.</p></div>
  </div>
</section>
