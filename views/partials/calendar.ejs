<% const base = user.role === 'client' ? '/client' : '/admin'; %>
<div class="row between">
  <h2 style="font-size:28px;font-weight:500"><strong class="b"><%= cal.title %></strong> <%= cal.weekday %></h2>
  <span class="row" style="gap:6px"><a class="bell" href="<%= base %>?m=<%= cal.prev %>" aria-label="Previous month"><%- icon('left', 20, 2.2) %></a><a class="bell" href="<%= base %>?m=<%= cal.next %>" aria-label="Next month"><%- icon('right', 20, 2.2) %></a></span>
</div>
<div class="cal">
  <% ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].forEach((w) => { %><div class="wd"><%= w %></div><% }) %>
  <% cal.days.forEach((d) => { %><div class="d <%= d.cls %>"><span><%= d.n %></span><i></i></div><% }) %>
</div>
<div class="legend"><span><i class="dot dot-amber"></i>Today</span><span><i class="dot"></i><%= user.role === 'client' ? 'Delivered to you' : 'Delivered' %></span><span><i class="dot dot-coral"></i><%= user.role === 'client' ? 'Collected' : 'Collection' %></span></div>
<h3 style="margin-top:6px">Today</h3>
<div class="day">
  <% if (!todayItems.length) { %><div class="slot"><span class="time">—</span><div class="line"></div></div><p class="small muted">No updates yet today. Tracking updates and collections show up here as they happen.</p><% } %>
  <% todayItems.forEach((e) => { %>
  <div class="slot">
    <span class="time"><%= e.time %></span>
    <<%- e.href ? 'a href="' + e.href + '"' : 'div' %> class="<%= e.tone %> grow"><span class="ico"><%- icon(e.icon) %></span><span style="min-width:0"><span class="t" style="display:block"><%= e.title %></span><span class="s" style="display:block"><%= e.sub %></span></span></<%- e.href ? 'a' : 'div' %>>
  </div>
  <% }) %>
</div>
