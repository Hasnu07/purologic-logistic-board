<%- include('../partials/top', { search: { action: '/admin/watches', placeholder: 'Watch no., reference or serial' } }) %>
<% const canEdit = user.role !== 'courier'; const label = (st) => (isClosed(st) ? st : isMoving(st) ? (st === 'Customs hold' ? 'On hold' : 'In transit') : 'With us'); %>
<div class="head">
  <div><h1>Watches</h1><p class="sub">Every piece that has passed through the board, by its own number. A shipment carrying several watches shows one row per watch.</p></div>
  <% if (canEdit) { %><a class="btn btn-primary" href="/admin/shipments/new"><%- icon('plus', 18, 2.2) %>Add watch</a><% } %>
</div>

<div class="tabs">
  <% [['all', 'All'], ['withus', 'With us'], ['transit', 'In transit'], ['delivered', 'Delivered']].forEach(([key, name]) => { %>
  <a class="<%= tab === key ? 'on' : '' %>" href="/admin/watches?tab=<%= key %><%= q ? '&q=' + encodeURIComponent(q) : '' %>"><%= name %><span class="n"><%= tabs[key].length %></span></a>
  <% }) %>
</div>

<div class="tile table-tile">
  <% if (!rows.length) { %><div class="empty"><%= q ? 'No watch matches that search.' : 'No watches on file yet.' %></div><% } else { %>
  <div class="scroll"><table>
    <thead><tr><th>Watch no.</th><th>Brand</th><th>Model</th><th>Reference</th><th>Serial</th><th>Watch date</th><th>Value</th><th>Shipment</th><th>Client</th><th>Status</th><th>Pictures</th><th><span class="sr">Open</span></th></tr></thead>
    <tbody>
    <% rows.forEach((r) => { %>
    <tr>
      <td class="no"><a href="/admin/watches?tab=<%= tab %>&w=<%= encodeURIComponent(r.watch_no) %>"><%= r.watch_no %></a></td>
      <td><%= r.brand || '—' %></td>
      <td class="b"><%= r.watch %></td>
      <td><%= r.reference || '—' %></td>
      <td class="muted"><%= r.serial || '—' %></td>
      <td class="muted"><%= r.watch_date || '—' %></td>
      <td class="b"><%= money(r.value, cur) %></td>
      <td><%= r.shipment_no %><%= r.watch_count > 1 ? ' · ' + r.watch_count + ' watches' : '' %></td>
      <td><%= r.client_no %></td>
      <td><span class="<%= isMoving(r.status) || isClosed(r.status) ? chipClass(r.status) : 'chip chip-amber' %>"><%= label(r.status) %></span></td>
      <td class="muted"><span class="status-line"><%- icon('image', 16) %><%= r.photo_count %></span></td>
      <td><a class="rb rb-line rb-sm" href="/admin/shipments/<%= r.id %>" aria-label="Open <%= r.watch_no %>"><%- icon('arrow', 16, 2.2) %></a></td>
    </tr>
    <% }) %>
    </tbody>
  </table></div>
  <% } %>
</div>

<%- include('../partials/mid') %>
<div><h1 style="font-size:28px">Watch info</h1><p class="sub" style="margin-top:2px">Look one up by number, reference or serial.</p></div>
<form class="search" method="get" action="/admin/watches" style="margin:0;max-width:none;flex:none">
  <input type="hidden" name="tab" value="<%= tab %>">
  <label class="sr" for="w-q">Find a watch</label>
  <input id="w-q" name="w" class="in" type="search" value="<%= w %>" placeholder="WT-00001" style="box-shadow:none;border-color:var(--field)">
  <button aria-label="Look up"><%- icon('search', 20) %></button>
</form>
<% if (!watch) { %><p class="small muted"><%= w ? 'No watch matches that.' : 'No watches on file yet.' %></p><% } else { %>
<div class="stack" style="border:1px solid var(--line);border-radius:24px;padding:24px">
  <div class="thumbs">
    <% detail.photos.forEach((p) => { %><figure class="photo"><img src="/files/photo/<%= p.id %>" alt="<%= p.label || 'Watch picture' %>"></figure><% }) %>
    <% for (let i = detail.photos.length; i < 3; i++) { %><figure class="photo"><%- icon('image', 26) %></figure><% } %>
  </div>
  <div><h3 style="font-size:20px"><%= [watch.brand, watch.watch].filter(Boolean).join(' ') %></h3><div class="small muted"><%= watch.watch_no %>, <%= watch.status.toLowerCase() %> on <%= watch.shipment_no %><%= detail.siblings > 0 ? ', travelling with ' + detail.siblings + ' other watch' + (detail.siblings === 1 ? '' : 'es') : '' %></div></div>
  <dl class="facts" style="grid-template-columns:repeat(2,minmax(0,1fr));gap:14px">
    <div><dt>Brand</dt><dd><%= watch.brand || '—' %></dd></div>
    <div><dt>Condition</dt><dd><%= watch.condition || 'Not inspected' %></dd></div>
    <div><dt>Serial</dt><dd><%= watch.serial || '—' %></dd></div>
    <div><dt>Watch date</dt><dd><%= watch.watch_date || '—' %></dd></div>
    <div><dt>Declared value</dt><dd><%= money(watch.value, cur) %></dd></div>
    <% if (canEdit) { %><div><dt>Shipment cost</dt><dd><%= money(watch.cost, cur) %></dd></div><% } %>
    <div><dt>Client</dt><dd><%= watch.client_no %></dd></div>
    <div><dt>Accessories</dt><dd><%= detail.accOk %> of <%= detail.accAll %></dd></div>
  </dl>
  <div class="row"><a class="btn btn-primary" href="/admin/shipments/<%= watch.id %>">Open details</a><a class="btn" style="min-height:48px" href="/admin/shipments/<%= watch.id %>/print?auto=1" target="_blank" rel="noopener"><%- icon('print') %>Print sheet</a></div>
</div>
<% } %>
<div class="tile tile-amber"><div class="b small">Next watch number</div><div class="t-big" style="font-size:38px;margin:4px 0"><%= numbering.watch.next %></div><div class="small b">Issued for every watch added, never reused</div></div>
<%- include('../partials/bottom') %>
