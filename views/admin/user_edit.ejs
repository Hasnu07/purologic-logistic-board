<%- include('../partials/top') %>
<nav class="crumbs" aria-label="Breadcrumb"><a href="<%= u.role === 'client' ? '/admin/clients' : '/admin/users' %>"><%= u.role === 'client' ? 'Clients' : 'Users' %></a><%- icon('right', 16, 2.2) %><span><%= u.number %></span></nav>
<div class="head">
  <div><h1><%= u.name %></h1><p class="sub"><%= ROLE_LABEL[u.role] %> <%= u.number %>. Created <%= fmtDate(u.created_at) %>, last login <%= u.last_login ? fmtDT(u.last_login) : 'never' %>.</p></div>
  <% if (u.role === 'client') { %><a class="btn btn-primary" href="/admin/shipments/new?client=<%= u.id %>"><%- icon('plus', 18, 2.2) %>New shipment</a><% } %>
</div>
<% if (error) { %><div class="flash flash-err" role="alert"><%= error %></div><% } %>
<% if (temp) { %>
<div class="tile tile-amber stack">
  <h2>Temporary password for <%= u.email %></h2>
  <p>Shown only once. Copy it now and pass it to <%= u.name %> together with their email. They will be asked to choose their own password at first sign-in.</p>
  <div><span class="secret"><%= temp %></span></div>
</div>
<% } %>

<form class="tile stack" method="post" action="/admin/users/<%= u.id %>" style="padding:28px">
  <h2>Account details</h2>
  <div class="grid2">
    <div><label class="lb" for="e-name">Name</label><input id="e-name" name="name" class="in" value="<%= u.name %>" required></div>
    <div><label class="lb" for="e-email">Email, used to sign in</label><input id="e-email" name="email" class="in" type="email" value="<%= u.email %>" required></div>
  </div>
  <div class="grid3">
    <div><label class="lb" for="e-phone">Phone</label><input id="e-phone" name="phone" class="in" value="<%= u.phone %>"></div>
    <div><label class="lb" for="e-city">City</label><input id="e-city" name="city" class="in" value="<%= u.city %>"></div>
    <div><label class="lb" for="e-status">Access</label><select id="e-status" name="status" class="in"><option value="active" <%= u.status === 'active' ? 'selected' : '' %>>Active</option><option value="suspended" <%= u.status === 'suspended' ? 'selected' : '' %>>Suspended, cannot sign in</option></select></div>
  </div>
  <div><label class="lb" for="e-addr"><%= u.role === 'client' ? 'Default delivery address' : 'Address' %></label><textarea id="e-addr" name="address" class="in" rows="3"><%= u.address %></textarea></div>
  <div><button class="btn btn-primary">Save user</button></div>
</form>

<% if (u.role === 'client') { %>
<section class="tile stack" style="padding:28px 24px">
  <h2>Recent shipments</h2>
  <% if (!shipments.length) { %><p class="small muted">No shipments for this client yet.</p><% } else { %>
  <div class="scroll"><table>
    <thead><tr><th>Shipment</th><th>Watch no.</th><th>Watch</th><th>Collected</th><th>Status</th><th>Cost</th></tr></thead>
    <tbody><% shipments.forEach((r) => { %>
    <tr><td class="b"><a href="/admin/shipments/<%= r.id %>"><%= r.shipment_no %></a></td><td class="no"><%= r.watch_no %></td><td><%= r.watch %></td><td><%= fmtDT(r.collected_at) %></td><td><span class="<%= chipClass(r.status) %>"><%= r.status %></span></td><td class="b"><%= money(r.cost, cur) %></td></tr>
    <% }) %></tbody>
  </table></div>
  <% } %>
</section>
<% } %>

<%- include('../partials/mid') %>
<% if (u.role === 'client') { %>
<div id="wallet"><h1 style="font-size:28px">Shipment wallet</h1></div>
<div class="grid2">
  <div class="tile tile-amber"><div class="t-label">Balance</div><div class="t-num"><%= money(wallet.balance, cur) %></div></div>
  <div class="tile tile-teal"><div class="t-label">Available</div><div class="t-num"><%= money(wallet.available, cur) %></div></div>
</div>
<p class="small muted">Pending charges on shipments still moving: <strong style="color:var(--ink)"><%= money(wallet.pending, cur) %></strong></p>
<form class="panel" method="post" action="/admin/users/<%= u.id %>/topup">
  <h3>Record a top-up</h3>
  <div><label class="lb" for="t-amt">Amount, <%= cur %></label><input id="t-amt" name="amount" class="in" type="number" step="0.01" required></div>
  <div><label class="lb" for="t-note">Note</label><input id="t-note" name="note" class="in" placeholder="Bank transfer 24 Nov"></div>
  <div><button class="btn btn-primary">Record top-up</button></div>
  <p class="hint">Record money you received from the client. Shipping costs paid from the wallet are deducted automatically. Use a negative amount to correct a mistake.</p>
  <% topups.forEach((t) => { %>
  <div class="kv small" style="border-top:1px solid var(--line);padding-top:10px"><span class="muted"><%= fmtDate(t.created_at) %><%= t.note ? ', ' + t.note : '' %>, by <%= t.by_name %></span><b><%= money(t.amount, cur) %></b></div>
  <% }) %>
</form>
<% } %>

<div><h2>Password</h2><p class="hint" style="margin-top:4px">Issues a new temporary password and signs this user out everywhere.</p></div>
<form method="post" action="/admin/users/<%= u.id %>/reset"><button class="btn">Reset password</button></form>

<h2>Signed-in devices</h2>
<% if (!sessions.length) { %><p class="small muted">Not signed in anywhere.</p><% } %>
<% sessions.forEach((x) => { %>
<div class="note">
  <div class="grow"><div class="b" style="color:var(--ink)"><%= x.device.replace(' · ', ' on ') %></div><div class="s">since <%= fmtDT(x.created_at) %></div></div>
  <form method="post" action="/admin/sessions/<%= x.id %>/end"><input type="hidden" name="back" value="/admin/users/<%= u.id %>"><button class="btn btn-sm">End</button></form>
</div>
<% }) %>
<%- include('../partials/bottom') %>
